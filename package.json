    "build": "./maven_local/apache-maven-3.9.9/bin/mvn clean package",
    "test": "./maven_local/apache-maven-3.9.9/bin/mvn test",
    "dev": "./maven_local/apache-maven-3.9.9/bin/mvn spring-boot:run -Dspring-boot.run.jvmArguments='-Dspring.devtools.restart.enabled=true'"
