{
  "name": "seatsync",
  "version": "1.0.0",
  "description": "SeatSync — office seat booking system for modern teams",
  "scripts": {
    "prestart": "node scripts/ensure-maven.js",
    "start": "node scripts/mvn-run.js spring-boot:run -DskipTests",
    "predev": "node scripts/ensure-maven.js",
    "start:test": "node scripts/mvn-run.js spring-boot:run",
    "build": "node scripts/mvn-run.js clean package -DskipTests",
    "test": "node scripts/mvn-run.js test",
    "dev": "node scripts/mvn-run.js spring-boot:run -DskipTests -Dspring-boot.run.jvmArguments=-Dspring.devtools.restart.enabled=true"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": ["seat-booking", "office", "spring-boot", "workspace"],
  "author": "SeatSync",
  "license": "MIT"
}
